{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/tcdata/sector",
      "destination": "https://science.nrlmry.navy.mil/geoips/tcdat/sectors/atcf_sector_file"
    },
    {
      "source": "/tcdata/btk/:file",
      "destination": "https://ftp.nhc.noaa.gov/atcf/btk/:file"
    },
    {
      "source": "/((?!assets|icons|favicon|refraction|tcdata).*)",
      "destination": "/index.html"
    }
  ]
}
